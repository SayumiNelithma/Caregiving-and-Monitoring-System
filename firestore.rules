rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - users can read their own data, admins can read all
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        isOwner(userId) || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow delete: if isAuthenticated() && (
        isOwner(userId) || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    // Journal entries collection - users can only access their own entries
    match /journal_entries/{entryId} {
      // Allow reading if user owns the entry
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow creating if user sets their own userId
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Allow updating if user owns the entry
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      
      // Allow deleting if user owns the entry
      allow delete: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Allow listing/querying own entries
      allow list: if isAuthenticated();
    }
    
    // Daily routines collection (for future use)
    match /daily_routines/{routineId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Meal plans collection (for future use)
    match /meal_plans/{mealPlanId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Therapy sessions collection (for future use)
    match /therapy_sessions/{sessionId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Common routine templates - available to all authenticated users
    match /common_routine_templates/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
      allow list: if isAuthenticated();
    }

    // Therapist assignments - caregivers can manage, elders can view their own
    match /therapist_assignments/{activityId} {
      allow read: if isAuthenticated() && (
        resource.data.elder_id == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['caregiver', 'admin']
      );
      allow create: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['caregiver', 'admin'];
      allow update: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['caregiver', 'admin'];
      allow delete: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['caregiver', 'admin'];
      allow list: if isAuthenticated();
    }

    // Medication prescriptions - caregivers can manage, elders can view their own
    match /medication_prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        resource.data.elder_id == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['caregiver', 'admin']
      );
      allow create: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['caregiver', 'admin'];
      allow update: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['caregiver', 'admin'];
      allow delete: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['caregiver', 'admin'];
      allow list: if isAuthenticated();
    }
  }
}

